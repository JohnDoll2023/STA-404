geom_tile() +
scale_fill_gradient(low="lightgrey", high="black") +
guides(fill=FALSE) +
labs(title="Continent Share of World GDP",
subtitle="[<0.1 (light grey) to >0.4 (black)]",
caption="Data source: Jennifer Bryan (2015) Gapminder package") +
theme_fivethirtyeight()
