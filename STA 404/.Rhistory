substring("YR1960",3)
as.numeric(substring("YR1960",3))
# OLD:  tidyr::gather
temp_DF %>%
group_by(vars) %>%
gather(key=cyear, value=measurement, YR1960, YR1961) %>%
mutate(year = as.numeric(substring(cyear,3))) %>%
select(-cyear)
# NEW:  tidyr::pivot_longer
temp_DF %>%
pivot_longer(cols=YR1960:YR1961,
names_to = "cyear",
values_to = "measurement") %>%
mutate(year = as.numeric(substring(cyear,3))) %>%
select(-cyear)
