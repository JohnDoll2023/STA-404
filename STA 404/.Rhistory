ohioDF <- read_csv("https://coronavirus.ohio.gov/static/COVIDSummaryData.csv")
#get ohio population from census.gov source = https://www.census.gov/data/datasets/time-series/demo/popest/2010s-counties-total.html#par_textimage_739801612
ohioPop <- read_excel("co-est2019-annres-39.xlsx")
