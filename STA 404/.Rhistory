geom_polygon(data=ohio_map, aes(x=long,y=lat,group=group, fill="white", colour="black")) +
geom_text(data = ohio_city_DF, aes ( x = long, y = lat, label = city)) +
coord_map() +       # map projection correction
theme_nothing()
