ggplot(mw_map, aes(x=long,y=lat,group=group,fill=region))+
geom_polygon(fill="white", colour="black")
ggplot(mw_map, aes(x=long,y=lat,group=group,fill=region))+
geom_polygon(fill="white", colour="black")
ggplot(mw_map, aes(x=long,y=lat,fill=region))+
geom_polygon(fill="white", colour="black")
ggplot(mw_map, aes(x=long,y=lat,group=group,fill=region))+
geom_polygon(fill="white", colour="black")
ggplot(mw_map, aes(x=long,y=lat,group=group,fill=region))+
geom_polygon(fill="white", colour="black") +
coord_map() +       # map projection correction
theme_nothing()
